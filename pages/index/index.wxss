/* 首页样式（黑白双主题，使用 CSS 变量） */
.header {
  padding: 32rpx 32rpx 0;
  background: var(--header-bg);
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.brand {
  display: flex;
  align-items: center;
}

.brand-icon {
  font-size: 64rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(124,58,237,0.3), rgba(91,33,182,0.3));
  border-radius: 24rpx;
  margin-right: 20rpx;
  border: 1rpx solid rgba(124,58,237,0.3);
}

.brand-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

.brand-subtitle {
  font-size: 22rpx;
  margin-top: 4rpx;
  color: var(--text-secondary);
}

.stats-pill {
  padding: 10rpx 24rpx;
  background: rgba(124,58,237,0.15);
  border-radius: 9999rpx;
  border: 1rpx solid rgba(124,58,237,0.25);
  color: var(--text-secondary);
}

.search-bar {
  display: flex;
  align-items: center;
  background: var(--bg-input);
  border: 1rpx solid var(--border-soft);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 8rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

/* Banner */
.banner-swiper {
  margin: 28rpx 32rpx 0;
  height: 200rpx;
  border-radius: 28rpx;
  overflow: hidden;
}

.banner-card {
  height: 100%;
  border-radius: 28rpx;
  padding: 36rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.banner-card::after {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
}

.banner-content {
  position: relative;
  z-index: 1;
  color: #ffffff;
  flex: 1;
}

.banner-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: rgba(255,255,255,0.2);
  color: #ffffff;
  border-radius: 9999rpx;
  backdrop-filter: blur(10rpx);
}

.banner-emoji {
  font-size: 120rpx;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 8rpx 24rpx rgba(0,0,0,0.3));
}

/* Section */
.section {
  padding: 0 32rpx;
}

.section-header {
  padding: 8rpx 0;
}

.section-title {
  color: var(--text-primary);
}

/* 快捷网格 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 8rpx;
  border-radius: 24rpx;
  background: var(--bg-input);
  transition: all 0.2s;
  position: relative;
}

.quick-item:active {
  transform: scale(0.95);
  background: var(--bg-hover);
}

.quick-name {
  font-size: 24rpx;
  text-align: center;
  line-height: 1.3;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text-primary);
}

/* 统计卡 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 40rpx 24rpx;
  background: var(--card-bg);
  border-radius: 28rpx;
  margin-top: 16rpx;
  border: 1rpx solid var(--border-soft);
  box-shadow: var(--shadow-card);
}

.stats-item {
  text-align: center;
  flex: 1;
}

.stats-divider {
  width: 2rpx;
  height: 80rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(124,58,237,0.3) 50%, transparent 100%);
}

/* 历史记录横滑 */
.history-scroll {
  white-space: nowrap;
  width: 100%;
  padding: 8rpx 0;
}

.history-list {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 32rpx;
}

.history-item {
  width: 140rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  border: 1rpx solid var(--border-soft);
}

.history-name {
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  color: var(--text-primary);
}

/* 收藏网格 */
.fav-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.fav-item {
  margin: 0;
  padding: 24rpx;
}

/* 热门排行 */
.hot-item {
  margin: 0 0 16rpx 0;
  padding: 24rpx;
}

.hot-rank {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: 26rpx;
}

.rank-top {
  background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
  -webkit-background-clip: text;
  color: transparent;
}

.arrow-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(124,58,237,0.15);
  border-radius: 50%;
  color: #a78bfa;
  font-size: 40rpx;
  font-weight: 300;
}
