.cat-page {
  padding-top: 0;
}

.search-wrap {
  padding: 24rpx 32rpx 16rpx;
  background: linear-gradient(180deg, #1a1033 0%, #0f0f1a 100%);
}

.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 18rpx;
  padding: 18rpx 24rpx;
}

.search-icon {
  font-size: 30rpx;
  margin-right: 14rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 50%;
}

/* 分类横滑 */
.cat-tabs {
  white-space: nowrap;
  padding: 16rpx 0;
  background: #0f0f1a;
  position: sticky;
  top: 0;
  z-index: 10;
}

.cat-tabs-inner {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 14rpx;
}

.cat-tab {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx;
  background: rgba(255,255,255,0.04);
  border-radius: 9999rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
  transition: all 0.25s;
  flex-shrink: 0;
}

.cat-tab-active {
  background: linear-gradient(135deg, rgba(124,58,237,0.3), rgba(91,33,182,0.3));
  border-color: rgba(124,58,237,0.5);
  box-shadow: 0 4rpx 20rpx rgba(124,58,237,0.25);
}

.cat-tab-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.cat-tab-name {
  font-size: 26rpx;
  color: #e8e8f0;
}

.cat-tab-active .cat-tab-name {
  color: #ffffff;
  font-weight: 600;
}

/* 分类信息卡 */
.cat-info-wrap {
  padding: 16rpx 32rpx 8rpx;
}

.cat-info-card {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  color: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(0,0,0,0.3);
}

.cat-info-icon {
  font-size: 80rpx;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.15);
  border-radius: 32rpx;
  margin-right: 28rpx;
}

.cat-info-content {
  flex: 1;
  color: #ffffff;
}

/* 工具网格 */
.tool-grid-wrap {
  padding: 0 24rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
}

.grid-tool-card {
  background: linear-gradient(145deg, #1a1a2e 0%, #16162a 100%);
  border-radius: 24rpx;
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  border: 1rpx solid rgba(124,58,237,0.08);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.2);
  position: relative;
  transition: all 0.2s;
}

.grid-tool-card:active {
  transform: scale(0.96);
}

.grid-tool-card .tool-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  font-size: 40rpx;
  margin-bottom: 0;
}

.grid-tool-name {
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

.grid-tool-desc {
  opacity: 0.6;
}

.vip-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #1a1a2e;
  font-weight: 700;
  border-radius: 9999rpx;
}

/* 工具列表（搜索结果） */
.tool-list {
  padding: 0 32rpx;
}

.tool-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: linear-gradient(145deg, #1a1a2e 0%, #16162a 100%);
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(124,58,237,0.08);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.2);
}

.tool-card .tool-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  font-size: 40rpx;
  margin-bottom: 0;
  flex-shrink: 0;
}

.result-header {
  padding: 16rpx 32rpx;
}
