/* 个人中心（黑白双主题，使用 CSS 变量） */
.mine-page {
  padding-top: 0;
}

.profile-section {
  position: relative;
  padding: 32rpx 32rpx 0;
  overflow: hidden;
}

.profile-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 360rpx;
  background: var(--profile-bg);
}

.profile-bg::after {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(124,58,237,0.35) 0%, transparent 65%);
  border-radius: 50%;
}

.profile-content {
  position: relative;
  z-index: 1;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: var(--card-bg);
  backdrop-filter: blur(20rpx);
  border-radius: 28rpx;
  border: 1rpx solid var(--border-soft);
  box-shadow: var(--shadow-card);
}

.avatar-wrap {
  position: relative;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  border: 2rpx solid rgba(124,58,237,0.4);
  overflow: hidden;
  background: linear-gradient(135deg, #2d1f4e, #1a1033);
}

.avatar-default {
  background: linear-gradient(135deg, #7c3aed, #5b21b6);
}

.avatar-login {
  background: var(--bg-input);
}

.avatar-vip-badge {
  position: absolute;
  bottom: -10rpx;
  right: -10rpx;
  font-size: 28rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  border-radius: 50%;
  border: 3rpx solid var(--bg-page);
}

.username {
  letter-spacing: -0.5rpx;
}

.login-btn {
  padding: 14rpx 32rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #fff;
  border-radius: 9999rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: var(--shadow-btn);
}

.logout-btn {
  padding: 10rpx 20rpx;
  background: var(--bg-input);
  border-radius: 9999rpx;
  border: 1rpx solid var(--border-soft);
}

/* 概览 */
.overview {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 24rpx;
  padding: 32rpx 24rpx;
  background: var(--card-bg);
  border-radius: 28rpx;
  border: 1rpx solid var(--border-soft);
  box-shadow: var(--shadow-card);
}

.overview-item {
  flex: 1;
  text-align: center;
  padding: 4rpx;
}

.overview-divider {
  width: 2rpx;
  height: 70rpx;
  background: linear-gradient(180deg, transparent, rgba(124,58,237,0.3), transparent);
}

/* 使用历史 */
.history-panel {
  margin: 28rpx 32rpx 0;
  background: var(--card-bg);
  border-radius: 24rpx;
  border: 1rpx solid var(--border-soft);
  overflow: hidden;
}

.history-scroll {
  padding: 0 8rpx 8rpx;
}

.history-row {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  margin: 0 8rpx 8rpx;
  background: var(--bg-input);
}

/* 菜单 */
.menu-container {
  padding: 28rpx 32rpx;
}

.menu-group {
  margin-bottom: 28rpx;
}

.menu-list {
  overflow: hidden;
}

.menu-item {
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--border-soft);
  transition: background 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-hover);
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(124,58,237,0.1);
  border-radius: 16rpx;
  flex-shrink: 0;
}

.menu-badge {
  padding: 6rpx 18rpx;
  background: rgba(124,58,237,0.15);
  color: #a78bfa;
  border-radius: 9999rpx;
  margin-right: 10rpx;
  border: 1rpx solid rgba(124,58,237,0.2);
}

.menu-arrow {
  font-size: 40rpx;
  width: 40rpx;
  text-align: center;
  opacity: 0.5;
}

/* 底部 */
.footer {
  padding: 20rpx 40rpx;
  line-height: 1.6;
}
