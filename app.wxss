/* ========== 全局样式 - 黑色/白色双主题 ========== */

/* --- 黑色主题（默认） --- */
page {
  --bg-page: #000000;
  --bg-card: #141414;
  --bg-card-2: #1c1c1c;
  --bg-input: rgba(255,255,255,0.06);
  --bg-hover: rgba(255,255,255,0.08);
  --bg-overlay: rgba(0,0,0,0.6);
  --text-primary: #ffffff;
  --text-secondary: #b0b0b0;
  --text-muted: #6e6e6e;
  --border-soft: rgba(255,255,255,0.08);
  --border-accent: rgba(255,255,255,0.2);
  --shadow-card: 0 8rpx 32rpx rgba(0,0,0,0.5);
  --shadow-btn: 0 8rpx 24rpx rgba(255,255,255,0.12);
  --accent: #7c3aed;
  --header-bg: linear-gradient(180deg, #1a1a1a 0%, var(--bg-page) 100%);
  --card-bg: linear-gradient(145deg, #141414 0%, #1c1c1c 100%);
  --profile-bg: linear-gradient(135deg, #1f1f1f 0%, #141414 50%, #000000 100%);

  background-color: var(--bg-page);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  transition: background-color 0.3s, color 0.3s;
}

/* --- 白色主题 --- */
.theme-light {
  --bg-page: #ffffff;
  --bg-card: #f7f7f7;
  --bg-card-2: #efefef;
  --bg-input: rgba(0,0,0,0.04);
  --bg-hover: rgba(0,0,0,0.04);
  --bg-overlay: rgba(0,0,0,0.3);
  --text-primary: #000000;
  --text-secondary: #5a5a5a;
  --text-muted: #9a9a9a;
  --border-soft: rgba(0,0,0,0.08);
  --border-accent: rgba(0,0,0,0.12);
  --shadow-card: 0 8rpx 32rpx rgba(0,0,0,0.06);
  --shadow-btn: 0 8rpx 24rpx rgba(124,58,237,0.2);
  --accent: #7c3aed;
  --header-bg: linear-gradient(180deg, #f0f0f0 0%, var(--bg-page) 100%);
  --card-bg: linear-gradient(145deg, #ffffff 0%, #f7f7f7 100%);
  --profile-bg: linear-gradient(135deg, #f0f0f0 0%, #e8e8e8 50%, #ffffff 100%);
}

/* 通用容器 */
.container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

.safe-area {
  padding-top: env(safe-area-inset-top);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 通用卡片 */
.card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 20rpx 0;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--border-soft);
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);
  color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: var(--shadow-btn);
}
.btn-primary::after { border: none; }

.btn-secondary {
  background: var(--bg-hover);
  color: var(--accent);
  border-radius: 16rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border: 1rpx solid var(--border-accent);
}
.btn-secondary::after { border: none; }

/* 文字颜色 */
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-muted { color: var(--text-muted); }
.text-accent { color: var(--accent); }
.text-success { color: #16a34a; }
.text-warning { color: #d97706; }
.text-danger { color: #dc2626; }

/* 字号 */
.text-xs { font-size: 22rpx; }
.text-sm { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 36rpx; }
.text-2xl { font-size: 44rpx; }
.text-3xl { font-size: 56rpx; }

.font-bold { font-weight: 700; }
.font-semibold { font-weight: 600; }
.font-medium { font-weight: 500; }

/* 边距 */
.m-0 { margin: 0; }
.m-1 { margin: 8rpx; }
.m-2 { margin: 16rpx; }
.m-3 { margin: 24rpx; }
.m-4 { margin: 32rpx; }
.p-0 { padding: 0; }
.p-2 { padding: 16rpx; }
.p-3 { padding: 24rpx; }
.p-4 { padding: 32rpx; }
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mt-4 { margin-top: 32rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }

/* flex */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.flex-wrap { flex-wrap: wrap; }
.items-center { align-items: center; }
.items-start { align-items: flex-start; }
.items-end { align-items: flex-end; }
.justify-center { justify-content: center; }
.justify-between { justify-content: space-between; }
.justify-around { justify-content: space-around; }
.justify-end { justify-content: flex-end; }
.flex-1 { flex: 1; }
.flex-shrink-0 { flex-shrink: 0; }

/* 网格 */
.grid { display: flex; flex-wrap: wrap; }
.grid-4 { width: 25%; }
.grid-3 { width: 33.333%; }
.grid-2 { width: 50%; }

/* 分割线 */
.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, var(--border-accent) 50%, transparent 100%);
  margin: 24rpx 0;
}

/* 圆角 */
.rounded { border-radius: 16rpx; }
.rounded-lg { border-radius: 24rpx; }
.rounded-full { border-radius: 9999rpx; }

/* VIP 标签 */
.vip-badge {
  display: inline-block;
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  color: #1a1a2e;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
  margin-left: 12rpx;
}

/* 工具图标 */
.tool-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 16rpx;
}
.icon-calc { background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%); }
.icon-convert { background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); }
.icon-note { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }
.icon-time { background: linear-gradient(135deg, #10b981 0%, #059669 100%); }
.icon-weather { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); }
.icon-qr { background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); }
.icon-random { background: linear-gradient(135deg, #ec4899 0%, #db2777 100%); }
.icon-compass { background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%); }
.icon-flash { background: linear-gradient(135deg, #fde047 0%, #facc15 100%); }
.icon-id { background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); }
.icon-money { background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); }
.icon-bmi { background: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%); }
.icon-default { background: linear-gradient(135deg, #64748b 0%, #475569 100%); }

/* 空状态 */
.empty-state {
  padding: 120rpx 0;
  text-align: center;
}
.empty-state .empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
  margin-bottom: 24rpx;
}
.empty-state .empty-text {
  color: var(--text-muted);
  font-size: 28rpx;
}

/* 输入卡片 */
.input-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--border-soft);
  box-shadow: var(--shadow-card);
}
.input-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}
.input-label { width: 160rpx; color: var(--text-secondary); }
.input-field {
  flex: 1;
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 600;
  text-align: right;
}
.input-unit { font-size: 24rpx; color: var(--text-secondary); margin-left: 12rpx; }
.divider-soft { border-bottom: 1rpx solid var(--border-soft); }

/* 结果卡片 */
.result-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid var(--border-accent);
  box-shadow: var(--shadow-card);
}

/* Tab 切换 */
.loan-tabs {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 0;
}
.loan-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--bg-input);
  border-radius: 16rpx;
  border: 1rpx solid var(--border-soft);
}
.loan-tab-active {
  color: var(--accent);
  background: var(--bg-hover);
  border-color: var(--border-accent);
  font-weight: 600;
}

/* 提示卡 */
.tip-card {
  padding: 24rpx;
  background: var(--bg-input);
  border-radius: 20rpx;
  border: 1rpx solid var(--border-soft);
}
