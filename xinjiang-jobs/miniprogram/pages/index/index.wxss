/* miniprogram/pages/index/index.wxss */
.page { padding: 20rpx 24rpx 40rpx; }
.status-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 8rpx 4rpx 16rpx;
}
.refresh-tip { color: #1e90ff; font-size: 24rpx; }
.filter-bar {
  display: flex; justify-content: space-around;
  background: #fff; border-radius: 16rpx; padding: 20rpx 0;
  margin-bottom: 24rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.filter-item { color: #1a1a1a; font-size: 28rpx; }
.empty { text-align: center; color: #8a8f99; padding: 80rpx 0; }
.job-card {
  background: #fff; border-radius: 16rpx; padding: 28rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.job-header { display: flex; justify-content: space-between; align-items: center; }
.job-title { font-size: 34rpx; font-weight: 600; color: #1a1a1a; flex: 1; margin-right: 16rpx; }
.salary { font-size: 32rpx; color: #ff5722; font-weight: 600; white-space: nowrap; }
.job-company { color: #4a4a4a; font-size: 28rpx; margin: 12rpx 0; }
.job-meta { color: #8a8f99; font-size: 24rpx; }
.tags { margin-top: 14rpx; }
.tag {
  display: inline-block; padding: 4rpx 14rpx; margin: 4rpx 8rpx 0 0;
  font-size: 22rpx; color: #1e90ff; background: #e6f1ff; border-radius: 20rpx;
}
.job-footer {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 14rpx;
}
.source-badge {
  font-size: 20rpx; color: #fff; background: #1e90ff;
  padding: 2rpx 12rpx; border-radius: 16rpx;
}
.footer { text-align: center; color: #8a8f99; padding: 24rpx 0; font-size: 24rpx; }
