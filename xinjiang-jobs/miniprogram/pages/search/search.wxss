/* miniprogram/pages/search/search.wxss */
.page { padding: 20rpx 24rpx; }
.search-box { display: flex; margin-bottom: 20rpx; }
.input {
  flex: 1; background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx;
  font-size: 28rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.btn-search {
  margin-left: 16rpx; background: #1e90ff; color: #fff;
  border-radius: 16rpx; padding: 0 32rpx; font-size: 28rpx; line-height: 80rpx;
}
.filters { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.filter-pill {
  background: #fff; padding: 14rpx 24rpx; border-radius: 40rpx;
  font-size: 26rpx; color: #4a4a4a;
}
.filter-pill.active { background: #e6f1ff; color: #1e90ff; }
.x { margin-left: 10rpx; color: #ff5722; }
.panel {
  background: #fff; border-radius: 16rpx; padding: 12rpx 0;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.panel-item { padding: 18rpx 28rpx; font-size: 28rpx; border-bottom: 1rpx solid #f0f2f5; }
.panel-empty { padding: 24rpx; text-align: center; }
.result-meta { padding: 8rpx 4rpx 16rpx; }
.empty { text-align: center; color: #8a8f99; padding: 80rpx 0; }
.job-card {
  background: #fff; border-radius: 16rpx; padding: 28rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.job-header { display: flex; justify-content: space-between; align-items: center; }
.job-title { font-size: 34rpx; font-weight: 600; flex: 1; margin-right: 16rpx; }
.salary { font-size: 32rpx; color: #ff5722; font-weight: 600; }
.job-company { color: #4a4a4a; font-size: 28rpx; margin: 12rpx 0; }
.job-meta { color: #8a8f99; font-size: 24rpx; }
.footer-line { margin-top: 12rpx; font-size: 24rpx; }
