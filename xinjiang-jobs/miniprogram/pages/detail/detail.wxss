/* miniprogram/pages/detail/detail.wxss */
.page { padding: 20rpx 24rpx; }
.card {
  background: #fff; border-radius: 16rpx; padding: 28rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.title-row { display: flex; justify-content: space-between; align-items: flex-start; }
.job-title { font-size: 36rpx; font-weight: 700; flex: 1; margin-right: 16rpx; }
.salary { font-size: 34rpx; color: #ff5722; font-weight: 600; }
.company { color: #1e90ff; font-size: 30rpx; margin: 14rpx 0 8rpx; }
.meta { color: #8a8f99; font-size: 24rpx; line-height: 1.8; }
.tags { margin-top: 14rpx; }
.tag {
  display: inline-block; padding: 4rpx 14rpx; margin: 4rpx 8rpx 0 0;
  font-size: 22rpx; color: #1e90ff; background: #e6f1ff; border-radius: 20rpx;
}
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 14rpx; }
.desc { font-size: 28rpx; color: #2a2a2a; line-height: 1.8; white-space: pre-wrap; }
.line { font-size: 28rpx; color: #2a2a2a; padding: 8rpx 0; }
.footer-meta {
  display: flex; justify-content: space-between; align-items: center;
  padding: 8rpx 4rpx 20rpx;
}
.source-badge { color: #1e90ff; font-size: 24rpx; }
.actions { margin-top: 12rpx; }
.actions .btn-primary { margin-bottom: 16rpx; }
